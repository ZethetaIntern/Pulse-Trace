{
  "name": "pulse-trace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "lint": "eslint \"apps/*/src/**/*.ts\"",
    "format": "prettier --write 'apps/*/src/**/*.ts'",
    "format:check": "prettier --check 'apps/*/src/**/*.ts'"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
