# =============================================================================
# PulseTrace — Development Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
#   cp .env.example .env
#
# IMPORTANT:
#   - Never commit .env or any file containing real credentials.
#   - This file uses safe defaults that work out-of-the-box for local dev.
#   - For production deployment, see .env.example.production instead.
# =============================================================================

# -----------------------------------------------------------------------------
# NODE_ENV
# -----------------------------------------------------------------------------
# Purpose:    Controls Express behavior, error verbosity, Swagger docs, and
#             CORS defaults.
# Example:    development | production | test
# Required:   No (defaults to "development" if not set)
# Dev safe:   Defaults to "development" — enables Swagger, relaxed CORS, and
#             verbose error messages.
NODE_ENV=development

# -----------------------------------------------------------------------------
# PORT
# -----------------------------------------------------------------------------
# Purpose:    The port the API server listens on.
# Example:    4000
# Required:   No (defaults to 4000 if not set)
# Dev safe:   Defaults to 4000. Change if another service uses that port.
PORT=4000

# -----------------------------------------------------------------------------
# DATABASE_URL
# -----------------------------------------------------------------------------
# Purpose:    PostgreSQL connection string used by Prisma ORM.
# Example:    postgresql://pulsetrace:pulsetrace@localhost:5432/pulsetrace
# Required:   Yes — the API cannot start without a reachable database.
# Dev safe:   Defaults to localhost:5432 with the dev credentials below.
#             In Docker Compose, the hostname is the service name (e.g. "postgres").
DATABASE_URL=postgresql://pulsetrace:pulsetrace@localhost:5432/pulsetrace

# -----------------------------------------------------------------------------
# REDIS_URL
# -----------------------------------------------------------------------------
# Purpose:    Redis connection string used by BullMQ for job queues.
# Example:    redis://localhost:6379
# Required:   Yes — the API cannot start without a reachable Redis instance.
# Dev safe:   Defaults to localhost:6379. In Docker Compose, use redis://redis:6379.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# KAFKA_BROKERS
# -----------------------------------------------------------------------------
# Purpose:    Comma-separated list of Kafka broker host:port addresses.
# Example:    localhost:9092
# Required:   No (defaults to "localhost:9092" if not set)
# Dev safe:   Defaults to localhost:9092. In Docker Compose, use kafka:29092.
KAFKA_BROKERS=localhost:9092

# -----------------------------------------------------------------------------
# KAFKA_CLIENT_ID
# -----------------------------------------------------------------------------
# Purpose:    Client identifier passed in Kafka requests for logging/tracing.
# Example:    pulsetrace-api
# Required:   No (defaults to "pulsetrace-api" if not set)
# Dev safe:   Defaults to "pulsetrace-api".
KAFKA_CLIENT_ID=pulsetrace-api

# -----------------------------------------------------------------------------
# KAFKA_CONSUMER_GROUP_ID
# -----------------------------------------------------------------------------
# Purpose:    Consumer group ID for notification processing workers.
# Example:    pulsetrace-notification-consumers
# Required:   No (defaults to "pulsetrace-notification-consumers" if not set)
# Dev safe:   Defaults to "pulsetrace-notification-consumers".
KAFKA_CONSUMER_GROUP_ID=pulsetrace-notification-consumers

# -----------------------------------------------------------------------------
# KAFKA_CONSUMER_CONCURRENCY
# -----------------------------------------------------------------------------
# Purpose:    Number of concurrent partition consumers per worker process.
# Example:    1
# Required:   No (defaults to 1)
# Dev safe:   Defaults to 1.
KAFKA_CONSUMER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# NOTIFICATION_PROCESSING_MODE
# -----------------------------------------------------------------------------
# Purpose:    Controlled migration switch between BullMQ and Kafka processing.
#             bullmq: Notifications enqueued to BullMQ (default).
#             kafka:  Notifications dispatched exclusively via Outbox -> Kafka.
# Example:    bullmq | kafka
# Required:   No (defaults to "bullmq")
# Dev safe:   Defaults to "bullmq".
NOTIFICATION_PROCESSING_MODE=bullmq

# -----------------------------------------------------------------------------
# RETRY_BASE_DELAY_MS
# -----------------------------------------------------------------------------
# Purpose:    Base delay in ms for exponential backoff retry calculations.
# Example:    1000
# Required:   No (defaults to 1000)
# Dev safe:   Defaults to 1000ms.
RETRY_BASE_DELAY_MS=1000

# -----------------------------------------------------------------------------
# RETRY_MAX_DELAY_MS
# -----------------------------------------------------------------------------
# Purpose:    Maximum capped delay in ms for exponential backoff retries.
# Example:    300000 (5 minutes)
# Required:   No (defaults to 300000)
# Dev safe:   Defaults to 300000ms.
RETRY_MAX_DELAY_MS=300000

# -----------------------------------------------------------------------------
# RETRY_MAX_ATTEMPTS
# -----------------------------------------------------------------------------
# Purpose:    Maximum total delivery attempts (initial attempt + retries) before DLQ.
# Example:    5
# Required:   No (defaults to 5)
# Dev safe:   Defaults to 5 total attempts.
RETRY_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# RETRY_JITTER_FACTOR
# -----------------------------------------------------------------------------
# Purpose:    Jitter factor (0.0 = no jitter, 1.0 = full jitter) applied to backoff.
# Example:    1.0
# Required:   No (defaults to 1.0)
# Dev safe:   Defaults to 1.0.
RETRY_JITTER_FACTOR=1.0

# -----------------------------------------------------------------------------
# KAFKA_RETRY_CONSUMER_GROUP_ID
# -----------------------------------------------------------------------------
# Purpose:    Dedicated consumer group ID for the retry Kafka consumer.
# Example:    pulsetrace-notification-retry-consumers
# Required:   No (defaults to "pulsetrace-notification-retry-consumers")
# Dev safe:   Defaults to "pulsetrace-notification-retry-consumers".
KAFKA_RETRY_CONSUMER_GROUP_ID=pulsetrace-notification-retry-consumers

# -----------------------------------------------------------------------------
# KAFKA_RETRY_CONSUMER_CONCURRENCY
# -----------------------------------------------------------------------------
# Purpose:    Concurrency for the retry Kafka consumer.
# Example:    1
# Required:   No (defaults to 1)
# Dev safe:   Defaults to 1.
KAFKA_RETRY_CONSUMER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# RETRY_SCHEDULER_POLL_INTERVAL_MS
# -----------------------------------------------------------------------------
# Purpose:    Polling interval in ms for the Redis ZSET delay scheduler worker.
# Example:    500
# Required:   No (defaults to 500)
# Dev safe:   Defaults to 500ms.
RETRY_SCHEDULER_POLL_INTERVAL_MS=500

# -----------------------------------------------------------------------------
# RETRY_SCHEDULER_BATCH_SIZE
# -----------------------------------------------------------------------------
# Purpose:    Maximum number of due retry entries fetched per poll cycle.
# Example:    50
# Required:   No (defaults to 50)
# Dev safe:   Defaults to 50.
RETRY_SCHEDULER_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# RETRY_SCHEDULER_LEASE_TTL_MS
# -----------------------------------------------------------------------------
# Purpose:    Lease TTL in ms for claimed retry entries in Redis during publication.
# Example:    30000 (30 seconds)
# Required:   No (defaults to 30000)
# Dev safe:   Defaults to 30000ms.
RETRY_SCHEDULER_LEASE_TTL_MS=30000

# -----------------------------------------------------------------------------
# LOG_LEVEL
# -----------------------------------------------------------------------------
# Purpose:    Controls Pino logger verbosity. Higher = less output.
# Example:    debug | info | warn | error
# Required:   No (defaults to "info" if not set)
# Dev safe:   Defaults to "info". Use "debug" for verbose request tracing.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS_ORIGINS
# -----------------------------------------------------------------------------
# Purpose:    Comma-separated list of allowed CORS origins. Only these origins
#             may make browser requests to the API.
# Example:    http://localhost:5173,http://localhost:3000
# Required:   No — in development, defaults to "*" (all origins allowed).
#             In production (NODE_ENV=production), MUST be explicitly set.
# Dev safe:   If empty/unset in development, all origins are permitted.
#             In production, an empty value rejects all cross-origin requests
#             (non-browser clients like curl are unaffected).
#CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# QUEUE_ATTEMPTS
# -----------------------------------------------------------------------------
# Purpose:    Maximum number of times a BullMQ job is retried on failure.
# Example:    3
# Required:   No (defaults to 3 in development, 5 in production compose)
# Dev safe:   Defaults to 3. Increase for production to improve delivery
#             resilience against transient provider failures.
#QUEUE_ATTEMPTS=3

# -----------------------------------------------------------------------------
# QUEUE_BACKOFF_MS
# -----------------------------------------------------------------------------
# Purpose:    Delay (in milliseconds) between retry attempts for failed jobs.
# Example:    1000
# Required:   No (defaults to 1000 in development, 2000 in production compose)
# Dev safe:   Defaults to 1000ms. Increase for production to avoid hammering
#             failing providers during outages.
#QUEUE_BACKOFF_MS=1000

# -----------------------------------------------------------------------------
# RUN_MIGRATIONS
# -----------------------------------------------------------------------------
# Purpose:    When set to "true", runs `prisma migrate deploy` before starting
#             the API server. Used in Docker production deployments only.
# Example:    true | false
# Required:   No (defaults to false if not set)
# Dev safe:   Defaults to false — migrations are skipped. In local dev, use
#             `npx prisma migrate dev` instead. In production Docker, set to
#             "true" on first deploy or after adding new migrations. NEVER
#             enable on multiple replicas simultaneously.
#RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS
# -----------------------------------------------------------------------------
# Purpose:    Time window in milliseconds for the per-IP rate limiter.
# Example:    60000 (1 minute)
# Required:   No (defaults to 60000)
# Dev safe:   Defaults to 60000ms. Tests use generous limits.
#RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX
# -----------------------------------------------------------------------------
# Purpose:    Maximum number of requests per window per IP.
# Example:    100
# Required:   No (defaults to 100)
# Dev safe:   Defaults to 100. Tests use generous limits.
#RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# ANALYTICS_MAX_RANGE_DAYS
# -----------------------------------------------------------------------------
# Purpose:    Maximum allowed analytics date range in days.
#             Requests exceeding this range return a validation error.
# Example:    365
# Required:   No (defaults to 365)
# Dev safe:   Defaults to 365 days.
#ANALYTICS_MAX_RANGE_DAYS=365
