# =============================================================================
# PulseTrace — Production Environment Template
# =============================================================================
#
# This is a TEMPLATE ONLY. It is NOT meant to be used directly.
#
# Instructions:
#   1. Copy this file to .env.production:
#        cp .env.example.production .env.production
#   2. Replace ALL placeholder values with real credentials.
#   3. NEVER commit .env.production to version control.
#   4. NEVER share this file or paste its contents into chat/logs.
#   5. Inject this file via Docker Compose:
#        docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# The docker-compose.prod.yml file references these variables with ${VAR:-default}
# syntax. If a variable is set here, the compose file uses it; otherwise the
# default (development-safe) value is used.
# =============================================================================

# -----------------------------------------------------------------------------
# NODE_ENV
# -----------------------------------------------------------------------------
# Must be "production" for all deployed environments.
# Enables: production error handling, disables Swagger UI, enforces CORS policy.
NODE_ENV=production

# -----------------------------------------------------------------------------
# PORT
# -----------------------------------------------------------------------------
# The port the API container listens on (internal to Docker network).
# Nginx reverse-proxies to this port. Do NOT expose to host.
PORT=4000

# -----------------------------------------------------------------------------
# DATABASE_URL
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Use the Docker service name "postgres" as
# hostname (Docker internal DNS resolves it). Replace <STRONG_PASSWORD> with
# a real, strong password.
# Format: postgresql://<USER>:<PASSWORD>@postgres:5432/<DATABASE>
DATABASE_URL=postgresql://pulsetrace:<STRONG_PASSWORD>@postgres:5432/pulsetrace

# -----------------------------------------------------------------------------
# REDIS_URL
# -----------------------------------------------------------------------------
# Redis connection string. Use the Docker service name "redis" as hostname.
# Format: redis://redis:6379
# For password-protected Redis: redis://:<REDIS_PASSWORD>@redis:6379
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# LOG_LEVEL
# -----------------------------------------------------------------------------
# Production log level. "info" is recommended; use "warn" to reduce noise.
# Never use "debug" in production — it may leak sensitive request data.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS_ORIGINS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. This MUST be set in
# production — an empty value rejects all cross-origin requests.
# Replace <YOUR_DOMAIN> with your actual frontend domain(s).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://<YOUR_DOMAIN>

# -----------------------------------------------------------------------------
# PostgreSQL credentials (used by the postgres service itself)
# -----------------------------------------------------------------------------
# These must match the credentials in DATABASE_URL above.
# Replace <STRONG_PASSWORD> with the same password used in DATABASE_URL.
POSTGRES_USER=pulsetrace
POSTGRES_PASSWORD=<STRONG_PASSWORD>
POSTGRES_DB=pulsetrace

# -----------------------------------------------------------------------------
# QUEUE_ATTEMPTS
# -----------------------------------------------------------------------------
# Maximum retry attempts for failed BullMQ jobs.
# 5 is recommended for production to handle transient provider outages.
QUEUE_ATTEMPTS=5

# -----------------------------------------------------------------------------
# QUEUE_BACKOFF_MS
# -----------------------------------------------------------------------------
# Delay in milliseconds between retry attempts.
# 2000ms gives failing providers time to recover without overwhelming them.
QUEUE_BACKOFF_MS=2000

# -----------------------------------------------------------------------------
# RUN_MIGRATIONS
# -----------------------------------------------------------------------------
# Set to "true" ONLY on the first deploy or after adding new migrations.
# NEVER enable on multiple containers simultaneously — Prisma migrate deploy
# is not designed for concurrent execution.
# After the first deploy, set this back to "false".
RUN_MIGRATIONS=false

# -----------------------------------------------------------------------------
# NGINX_PORT (optional)
# -----------------------------------------------------------------------------
# The host port nginx listens on. Defaults to 80.
# Only change if port 80 is already in use on the host.
#NGINX_PORT=80

# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS
# -----------------------------------------------------------------------------
# Time window in milliseconds for the per-IP rate limiter.
# 60000 (1 minute) is recommended for production.
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX
# -----------------------------------------------------------------------------
# Maximum requests per IP per rate-limit window.
# 100 is a reasonable production default for an MVP.
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# ANALYTICS_MAX_RANGE_DAYS
# -----------------------------------------------------------------------------
# Maximum allowed analytics date range in days.
# Prevents expensive database queries from unbounded date ranges.
ANALYTICS_MAX_RANGE_DAYS=365
